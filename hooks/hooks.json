{
  "description": "Keeps the pipeline dashboard alive while any Claude Code session is open (stops it when the last one closes), shows a one-time hint about /toolkit, tells you which plugins fit the project you open and are not installed, and gives you the dashboard link as soon as SPEC.md and ROADMAP.md are written.",
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/setup-pipeline/dashboard.mjs\" --session-start", "timeout": 10 },
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/toolkit/toolkit.mjs\" --nudge", "timeout": 10 },
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/toolkit/toolkit.mjs\" --suggest", "timeout": 10 }
      ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit", "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/setup-pipeline/dashboard.mjs\" --docs-hook", "timeout": 20 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/setup-pipeline/dashboard.mjs\" --session-end", "timeout": 10 } ] }
    ]
  }
}
